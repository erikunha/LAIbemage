# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/

# Environment — NEVER commit real keys
.env
.env.local
.env.*.local

# Raw image data — keep out of git (use examples/ for sample data)
input/
output/
!output/.gitkeep
!examples/

# Staged benchmark datasets — fetched locally, never committed.
# `datasets/*/` covers EVERY dataset directory (visa-subset/, cache/, and any
# other dataset id a future entry may add), while datasets/registry.json —
# the tracked license registry — stays outside it.
datasets/*/
benchmarks/results/


# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
*.log

# Coverage
coverage/
.nyc_output/

# Legacy harness reports — provider outputs of the synthetic unit-fixture run.
# They are run artifacts, never source.
reports/

# Generated API docs
docs/api/

# TypeScript cache
*.tsbuildinfo

# Hook output (secrets-scanner, test-gate)
logs/

# Claude Code local overrides (machine-specific permissions)
.claude/settings.local.json

# Turbo local cache
.turbo/

# Python (services/*)
.venv/
__pycache__/
*.pyc
.pytest_cache/
