{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-lens.example/schemas/worker-request.v1.json",
  "title": "VisionLens Worker Request v1 (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "kind",
    "requestId",
    "operation",
    "contractVersion",
    "workspaceId",
    "params",
    "budget"
  ],
  "properties": {
    "protocol": {
      "const": "visionlens.worker.v1"
    },
    "kind": {
      "const": "request"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "type": "string",
      "enum": [
        "vision.embed",
        "vision.predict",
        "dataset.audit",
        "eval.run",
        "model.train"
      ]
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSeconds",
        "maxUsdMicro"
      ],
      "properties": {
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxUsdMicro": {
          "type": "integer",
          "minimum": 0
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
