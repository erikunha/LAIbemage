{
  "name": "ai-image-labeling",
  "version": "0.0.1",
  "description": "Master Vision monorepo root (product formerly published from this package; publishing identity moves to workspace packages in the next commit).",
  "type": "module",
  "private": true,
  "main": "./packages/core/dist/sdk.js",
  "exports": {
    ".": "./packages/core/dist/sdk.js",
    "./cli": "./packages/core/dist/cli/index.js"
  },
  "bin": {
    "ai-image-labeling": "./packages/core/dist/cli/index.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "better-sqlite3",
      "protobufjs",
      "sharp"
    ]
  },
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=18",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node --watch packages/core/dist/cli/index.js",
    "start": "node packages/core/dist/cli/index.js",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "pretest": "tsx scripts/generate-fixtures.ts",
    "readme:generate": "tsx scripts/gen-readme-flags.ts",
    "readme:check": "tsx scripts/gen-readme-flags.ts --check",
    "lint": "eslint packages/core/src packages/core/tests",
    "lint:fix": "eslint packages/core/src packages/core/tests --fix",
    "format": "prettier --write \"packages/core/src/**/*.ts\" \"packages/core/tests/**/*.ts\"",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:generate": "tsx scripts/generate-benchmark-fixtures.ts",
    "benchmark:update-baseline": "tsx scripts/benchmark.ts --update-baseline",
    "docs:generate": "typedoc",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "mutate": "stryker run",
    "commit": "cz",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run typecheck && pnpm test",
    "commit-msg": "commitlint --edit $1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "vision",
    "master-vision",
    "cli",
    "image-processing",
    "typescript",
    "computer-vision"
  ],
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "4.1.5",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.3.0",
    "globals": "^17.6.0",
    "lint-staged": "17.0.2",
    "prettier": "3.8.3",
    "sharp": "0.34.5",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.19",
    "typescript": "6.0.3",
    "vite": "^8.0.11",
    "vitest": "4.1.5"
  }
}
