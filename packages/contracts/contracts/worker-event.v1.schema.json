{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "visionlens.worker.v1",
          "description": "The protocol identity string, fixed at \"visionlens.worker.v1\"."
        },
        "kind": {
          "type": "string",
          "const": "progress"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Sequence number of a frame: strictly increasing per request, starting at 0."
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocol",
        "kind",
        "requestId",
        "seq",
        "completed",
        "total"
      ],
      "additionalProperties": false,
      "description": "The progress envelope; completed never exceeds total."
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "visionlens.worker.v1",
          "description": "The protocol identity string, fixed at \"visionlens.worker.v1\"."
        },
        "kind": {
          "type": "string",
          "const": "result"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Sequence number of a frame: strictly increasing per request, starting at 0."
        },
        "result": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "protocol",
        "kind",
        "requestId",
        "seq",
        "result"
      ],
      "additionalProperties": false,
      "description": "The result envelope: emitted at most once per requestId."
    },
    {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "visionlens.worker.v1",
          "description": "The protocol identity string, fixed at \"visionlens.worker.v1\"."
        },
        "kind": {
          "type": "string",
          "const": "error"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Sequence number of a frame: strictly increasing per request, starting at 0."
        },
        "code": {
          "type": "string",
          "enum": [
            "UNSUPPORTED_PROTOCOL",
            "MISSING_EXTRA",
            "MALFORMED_FRAME",
            "PROTOCOL_MISMATCH",
            "UNSUPPORTED_OPERATION",
            "CANCELLED",
            "DEADLINE_EXCEEDED",
            "BUDGET_EXCEEDED",
            "WORKER_CRASHED",
            "PROVIDER_UNAVAILABLE"
          ],
          "description": "One of the ten frozen worker error codes."
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "protocol",
        "kind",
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false,
      "description": "The error envelope: a typed code, a message and the retryable flag."
