  "$id": "https://vision-lens.dev/contracts/worker-event.v1.schema.json",
  "title": "visionlens.worker.v1 event frame",
  "description": "The worker-to-host event envelopes (progress, result, error) of the frozen visionlens.worker.v1 JSONL protocol. Generated from the zod schemas in packages/contracts/src/worker/event.ts; never hand edited."
}
