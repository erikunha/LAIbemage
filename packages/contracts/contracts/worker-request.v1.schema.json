{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "visionlens.worker.v1",
      "description": "The protocol identity string, fixed at \"visionlens.worker.v1\"."
    },
    "kind": {
      "type": "string",
      "const": "request"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Request identifier: 1 to 128 characters, unique among requests."
    },
    "operation": {
      "type": "string",
      "enum": [
        "vision.embed",
        "vision.predict",
        "dataset.audit",
        "eval.run",
        "model.train"
      ],
      "description": "One of the five v1 operation codes."
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "A semantic version of the form major.minor.patch."
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "maxUsdMicro": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxSeconds",
        "maxUsdMicro"
      ],
      "additionalProperties": false,
      "description": "The resource budget of a request; unknown properties are forbidden."
    }
  },
  "required": [
    "protocol",
    "kind",
    "requestId",
    "operation",
    "contractVersion",
    "workspaceId",
    "params",
    "budget"
  ],
  "additionalProperties": false,
  "description": "The host-to-worker request envelope of the frozen visionlens.worker.v1 JSONL protocol. Generated from the zod schema in packages/contracts/src/worker/request.ts; never hand edited.",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "$id": "https://vision-lens.dev/contracts/worker-request.v1.schema.json",
  "title": "visionlens.worker.v1 request frame"
}
