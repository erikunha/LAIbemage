{
  "name": "@master-vision/core",
  "version": "0.0.1",
  "description": "Master Vision core: pipeline, providers, domain services (evolved from ai-image-labeling).",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./analyzer/batch": "./dist/analyzer/batch.js",
    "./analyzer/client": "./dist/analyzer/client.js",
    "./analyzer/consensus": "./dist/analyzer/consensus.js",
    "./analyzer/embeddings": "./dist/analyzer/embeddings.js",
    "./analyzer/sessions": "./dist/analyzer/sessions.js",
    "./analyzer/suggest": "./dist/analyzer/suggest.js",
    "./classifier": "./dist/classifier/index.js",
    "./config": "./dist/config/index.js",
    "./diff": "./dist/diff/index.js",
    "./fs": "./dist/fs/index.js",
    "./reporter/sqlite-schema": "./dist/reporter/sqlite-schema.js",
    "./search": "./dist/search/index.js",
    "./search/query": "./dist/search/query.js",
    "./types": "./dist/types.js",
    "./utils/logger": "./dist/utils/logger.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --root ../.. packages/core/tests"
  },
  "dependencies": {
    "@master-vision/contracts": "workspace:*",
    "@anthropic-ai/sdk": "0.95.1",
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@azure/storage-blob": "^12.31.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "0.24.1",
    "@inquirer/input": "^5.0.12",
    "@inquirer/select": "^5.1.4",
    "chalk": "5.6.2",
    "chokidar": "5.0.0",
    "cli-progress": "3.12.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "exifr": "7.1.3",
    "file-type": "22.0.1",
    "fs-extra": "11.3.5",
    "openai": "6.37.0",
    "ora": "9.4.0",
    "p-limit": "7.3.0",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-progress": "3.11.6",
    "@types/fs-extra": "11.0.4",
    "@types/node": "25.6.2"
  }
}
